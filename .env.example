APP_NAME="CMNHousing Admin Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Other CMNHousing databases Admin reads (see README "Connected apps").
# Leave these unset when the other repos are cloned next to this one
# (../CMN-housing, ../CMN-Dashboard, ../CMN-Emp, ../CMN-Agent): the defaults
# point at their database/database.sqlite files.
# -----------------------------------------------------------------------------
# Builder portal (CMN-housing): projects, leads, support tickets, notifications
# HOUSING_DB_DATABASE=/absolute/path/to/CMN-housing/database/database.sqlite

# User website (CMN-Dashboard / live cmn_laravel_13): listings, views, site visits
# DASHBOARD_DB_DATABASE=/absolute/path/to/CMN-Dashboard/database/database.sqlite

# Operations (CMN-Emp): listing review trail
# OPS_DB_DATABASE=/absolute/path/to/CMN-Emp/database/database.sqlite

# Agent portal (CMN-Agent): SQLite file, or set AGENT_DB_HOST for MySQL
# AGENT_DB_DATABASE=/absolute/path/to/CMN-Agent/database/database.sqlite
# AGENT_DB_HOST=
# AGENT_DB_PORT=3306
# AGENT_DB_NAME=cmn_agent
# AGENT_DB_USERNAME=root
# AGENT_DB_PASSWORD=

# Live website payments (payments_plans, payment_transactions).
# Without LIVE_DB_HOST it uses database/live.sqlite, filled with:
#   php artisan live:import-dump <payments_plans.sql> <payment_transactions.sql>
# LIVE_DB_HOST=
# LIVE_DB_PORT=3306
# LIVE_DB_DATABASE=cmn_laravel_13
# LIVE_DB_USERNAME=root
# LIVE_DB_PASSWORD=
PAYMENTS_DB_CONNECTION=live
PAYMENTS_INVOICE_BASE_URL=

# Links to the other portals and website assets
HOUSING_PUBLIC_URL=http://localhost:8091
BRM_URL=http://localhost:8090
PROPERTY_IMAGE_BASE=
WEBSITE_LISTING_URL=
